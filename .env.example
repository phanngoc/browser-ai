TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. Any OpenAI-compatible endpoint.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Fallback chooser when TYPESAFE_API_KEY is empty (--chooser llm): any OpenAI-compatible chat model
CHOOSER_MODEL=google/gemini-2.5-flash-lite
# Optional: override Chrome binary
CHROME_PATH=
